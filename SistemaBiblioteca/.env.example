# Copia este archivo como .env solo si necesitas cambiar la configuración.
# El archivo .env no se sube a GitHub.

# ---------------------------------------------------------------------
# Modo local (por defecto): SQLite, sin servidor ni contraseña.
# ---------------------------------------------------------------------
DB_DRIVER=sqlite
DB_SQLITE_PATH=database/biblioteca.sqlite

# ---------------------------------------------------------------------
# Modo MariaDB/MySQL (sprint 2). Descomenta y ajusta si lo necesitas.
# ---------------------------------------------------------------------
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_NAME=biblioteca
# DB_USER=root
# DB_PASS=
